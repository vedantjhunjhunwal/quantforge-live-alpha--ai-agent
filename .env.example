# QuantForge Full AI Agent
# Required for full AI-agent mode with OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional alternative for Gemini mode:
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Market data notes:
# - Binance public OHLCV through ccxt does not require an API key.
# - Yahoo Finance through yfinance does not require an API key.
# - The project intentionally does not fall back to synthetic market data.
